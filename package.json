{
  "name": "stockpulse-ts",
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "CLI tool for Indian stock research with screeners, backtesting, and AI insights",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "stockpulse": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "OPEN_BROWSER=1 tsx src/server.ts",
    "cli": "tsx src/cli/index.ts",
    "dev:server": "tsx src/server.ts",
    "start:server": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "stocks",
    "india",
    "research",
    "screening",
    "backtesting"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@types/commander": "^2.12.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.23",
    "inquirer": "^14.2.0",
    "kiteconnect": "^5.3.0",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.5.4"
  }
}
