{
  "name": "stockpulse-ts",
  "version": "1.0.0",
  "description": "CLI tool for Indian stock research with screeners, backtesting, and AI insights",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "stockpulse": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "stocks",
    "india",
    "research",
    "screening",
    "backtesting"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@types/commander": "^2.12.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "inquirer": "^14.2.0",
    "zod": "^4.5.4"
  }
}
